# Admin role: schema setup and ingestion only. Never used on the request path.
ADMIN_DSN=postgresql://admin:admin@localhost:5434/securerag
# Least-privilege app role: NOSUPERUSER, NOBYPASSRLS, owns nothing.
APP_DSN=postgresql://rag_app:rag_app_pw@localhost:5434/securerag
RAG_APP_PASSWORD=rag_app_pw

JWT_SECRET=change-me-to-a-long-random-string

# bge | hash      (hash = dependency-free stand-in used by tests)
EMBEDDER=bge
# bge | none
RERANKER=bge
# groq | mock     (mock = extractive, no API key)
GENERATOR=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# off | relaxed_order | strict_order
HNSW_ITERATIVE_SCAN=relaxed_order
HNSW_EF_SEARCH=40

CACHE_ENABLED=true
CACHE_THRESHOLD=0.95
# Store raw query text in the audit log (default: hash only)
AUDIT_STORE_QUERY=false
